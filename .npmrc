# Usa primeiro o armazém local de pacotes (instalações offline/rápidas quando já em cache).
prefer-offline=true

# Encurta os nomes das pastas do armazém virtual (node_modules/.pnpm).
#
# Porquê: o pnpm baptiza essas pastas com o pacote MAIS todos os seus pares, o
# que produz nomes como `app-builder-lib@25.1.8_dmg-builder@25.1.8_electron-
# builder-squirrel-windows@25.1.8`. Somado à profundidade deste repositório, o
# caminho de um ficheiro de template do NSIS chegava a 262 caracteres — dois
# acima do limite MAX_PATH (260) do Windows. O `makensis` não conseguia abrir o
# ficheiro e a criação do instalador Windows abortava.
#
# Com 60, o mesmo caminho fica com folga confortável. Afeta apenas o nome das
# pastas internas do pnpm; nada no código muda.
virtual-store-dir-max-length=60
