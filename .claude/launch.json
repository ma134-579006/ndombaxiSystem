{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nexus/web",
        "dev"
      ],
      "port": 5175
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nexus/web",
        "preview"
      ],
      "port": 5175
    },
    {
      "name": "pos",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nexus/pos",
        "preview"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "pos-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nexus/pos",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "pos-dev-local-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nexus/pos",
        "dev"
      ],
      "env": { "PAPI_TARGET": "http://localhost:3300" },
      "port": 5173
    },
    {
      "name": "store",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nexus/store",
        "preview"
      ],
      "port": 5174
    },
    {
      "name": "store-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nexus/store",
        "dev"
      ],
      "port": 5174
    }
  ]
}