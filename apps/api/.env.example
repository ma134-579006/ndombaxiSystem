# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ─── Database (PostgreSQL) ─────────────────────────────────────
# Matches infra/docker/docker-compose.yml defaults
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus_erp?schema=nexus_public

# ─── JWT / Auth ────────────────────────────────────────────────
# Generate strong secrets: `openssl rand -hex 48`
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_xxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_xxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── 2FA ───────────────────────────────────────────────────────
TWOFA_ISSUER=NEXUS ERP

# ─── Rate limiting (Zero Trust) ────────────────────────────────
RATE_LIMIT_USER_PER_MIN=100
RATE_LIMIT_TENANT_PER_MIN=1000

# ─── Redis (sessions / cache) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Super Admin bootstrap (seed) ──────────────────────────────
SUPER_ADMIN_EMAIL=admin@nexus-erp.ao
SUPER_ADMIN_PASSWORD=ChangeMe!Admin2025
