{
  "name": "@nexus/desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Ndombaxi System — aplicação Windows Offline-First (Gestão, Caixa e Loja num só instalador).",
  "author": "Ndombaxi System",
  "main": "dist/main/index.js",
  "scripts": {
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build": "pnpm build:main && pnpm prepare:resources",
    "dev": "pnpm build:main && electron .",
    "dist:win": "pnpm build && electron-builder --win --x64 --arm64 --publish never",
    "dist:win-legacy": "pnpm build && electron-builder --config electron-builder-legacy.yml --win --x64 --ia32 --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "20.19.41",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "typescript": "^5.6.2"
  }
}
