# Compilação do processo principal e do preload
dist/

# Saídas do electron-builder (instaladores e app desempacotada)
release/
release-locked-*/
dist-installer/
build-out/
out-final/

# Frontends compilados e copiados para dentro da app.
# NÃO se versionam: são gerados a partir de apps/web e apps/pos por
# `scripts/prepare-resources.mjs`. Versioná-los criaria duas fontes de verdade
# para a mesma interface — exatamente o que esta arquitetura existe para evitar.
resources/modules/gestao/
resources/modules/caixa/
resources/modules/launcher/logo.png

# SERVIDOR LOCAL empacotado — gerado por `scripts/prepare-server.mjs`.
# São ~120 MB de binários do PostgreSQL (que nem sequer são nossos) e a API
# compilada com as suas dependências. Versionar isto encheria o repositório e
# criaria uma segunda fonte de verdade para código que já cá está em `apps/api`.
resources/pgsql/
resources/api/
.pg-tmp/

# Ícone gerado a partir do logótipo oficial
build/icon.png

# Instalador gerado — NUNCA versionar (binário grande; sai do electron-builder).
setup/
