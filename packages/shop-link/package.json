{
  "name": "@nexus/shop-link",
  "version": "1.0.0",
  "private": true,
  "description": "Ndombaxi System — ligação ao servidor da loja (rede local), partilhada pelo Gestor e pela Caixa.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.2"
  }
}
