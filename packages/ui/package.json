{
  "name": "@nexus/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ndombaxi System — Design System único: componentes, estados e estilos partilhados por Web, Caixa, Loja, Desktop e Android. Zero dependências de runtime além do React.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles/index.css",
    "./base.css": "./styles/base.css",
    "./components.css": "./styles/components.css"
  },
  "files": [
    "src",
    "styles"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@nexus/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.25",
    "typescript": "^5.6.2"
  }
}
