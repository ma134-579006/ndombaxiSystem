{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "typeRoots": ["../../apps/api/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
